# RoutePulse backend environment variables.
# Leave optional values blank when using the default local setup.

# Optional Groq key for the LLM explanation layer. Core prediction works without it.
GROQ_API_KEY=

# Optional comma-separated browser origins. Example: http://localhost:5173
# Leave blank to use the development default.
ROUTEPULSE_CORS_ORIGINS=

# Optional data directory. Leave blank to use the project-level ../data directory.
ROUTEPULSE_DATA_DIR=

# Optional path to an alternate env file used by the Groq explanation layer.
ROUTEPULSE_ENV=
