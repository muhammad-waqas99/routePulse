# RoutePulse backend configuration (copy to .env and adjust as needed)

# Host/port used by uvicorn when started manually (see README).
ROUTEPULSE_HOST=127.0.0.1
ROUTEPULSE_PORT=8000

# Comma separated list of allowed CORS origins (the Vite dev server).
ROUTEPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Average vehicle speed (km/h) used to derive travel times from coordinates.
ROUTEPULSE_AVG_SPEED_KMH=20.0

# Fixed simulation seed (kept deterministic so runs are reproducible).
ROUTEPULSE_SIM_SEED=42
